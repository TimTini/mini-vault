            scale(shaft_stem_diameter/5) polygon(shaft_retention_outline);
    along_y(axial_y(8,15.5)-eps,1+2*eps) circle(r=1.5*shaft_stem_diameter/5);
}
module native_dial() {
    translate([0,-(door_plate_thickness-2),0]) {
        along_y(-13.4,.2+eps) measured_sketch(9,dial_marks,-13.3);
        difference() {
            union() {
                along_y(-13.2,1+eps) circle(r=20);
                along_y(-12.2,3+eps) polygon(dial_grip_outline);
                translate([0,-9.2,0]) rotate([-90,0,0]) cylinder(h=2,r1=20,r2=18);
            }
            along_y(-13.2-eps,4+eps) circle(r=7+fit_gap(.1));
            along_y(-13.2-eps,6+2*eps) union() {
                circle(r=5+fit_gap(.1));
                intersection() {
                    circle(r=7+fit_gap(.1));
                    translate([-(.5-fit_add(0)),0]) square([1,8]);
                }
            }
        }
    }
}
