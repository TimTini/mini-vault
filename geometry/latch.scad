function native_latch_points(points) = [for(p=split_profile_edges(points,0,[-74,-64,-39.5,-20,-18]))
    let(q=body_point(latch_guide_point(p)))
    [abs(p[0]+41.5)<.001 ? q[0]+fit_add(.2) : q[0],
     abs(abs(p[1])-1)<.001 && p[0]>=-39.5 ? q[1]-sign(p[1])*fit_add(.2) : q[1]]];
module native_latch_plate_sketch() {
    difference() {
        polygon(native_latch_points(latch_plate_loops[0][2]));
        for(i=[1,2]) offset(delta=-latch_pocket_inset)
            polygon(native_latch_points(latch_plate_loops[i][2]));
    }
}
module native_latch_round_grip_end() {
    rotate([-90,0,0]) rotate_extrude(convexity=4)
        polygon(concat([[0,-15]],
            [for(a=[-90:7.5:0]) [2.5+.5*cos(a),-14.5+.5*sin(a)]],
            [[3,-5+eps],[0,-5+eps]]));
}
module native_latch() {
    delta=model_body_width-142;
    // The grip alone follows the left door edge. Keep the link hook fixed.
    translate([-delta,0,0]) hull() for(x=[-50,-42])
        translate([x,0,0]) native_latch_round_grip_end();
    translate([-delta,0,0]) along_y(-5,1) hull() for(x=[-58,-34])
        translate([x,0]) circle(r=3.995);
    difference() {
        along_y(-4,4) native_latch_plate_sketch();
        // The outside tail bevel begins at Y=-2: X=-90 there, X=-88 at Y=0.
        translate([0,0,-30]) linear_extrude(height=60)
            polygon([[-model_body_width-100,-2],[-90-delta,-2],[-88-delta,0],[-model_body_width-100,0]]);
    }
    // Two independent tail tabs occupy Y=-5..-4; the diagonal web starts at -4.
    for(s=[-1,1]) scale([1,1,s]) difference() {
        along_y(-5,1) translate([-90-delta,16]) square([16,8]);
        translate([0,0,-30]) linear_extrude(height=60)
            polygon([[-75-delta,-5],[-74-delta,-4],[0,-4],[0,-5]]);
    }
    if(delta>0) along_y(-4,4) union() {
        if(delta>.5) translate([-41-delta,-2.5]) square([delta-.5+eps,5]);
        // Support the shifted grip neck when the broad rear face is on the bed.
        // Stop before the fixed T-slot so the link keeps its measured fit.
        intersection() {
            translate([-delta,0]) hull() for(x=[-58,-34])
                translate([x,0]) circle(r=3.995);
            translate([-model_body_width-100,-4])
                square([model_body_width+100-41.5,8]);
        }
    }
}
