# Publish a reviewed source set; keep local evidence, configuration and caches private.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/requirements.txt
!/mini-vault.scad
!/mini-vault.json
!/analyze.py
!/audit.py
!/exporter.py
!/profile_builder.py
!/prepare-minimum.py
!/prepare-scale-print.py
!/build.ps1
!/geometry/
!/profiles/
!/simulator/
!/tests/
!/docs/
!/work/

/docs/*
!/docs/CHI-TIET.md
!/docs/PUBLICATION.md
!/docs/parts/

/work/*
!/work/*.py
!/work/dialing-contact-verification.json
!/work/physical-dialing-audit.json
!/work/dial-visits-verification.json
!/work/inverse-code-verification.json
!/work/pin-orientation-verification.json
!/work/simulator-context-verification.json

# Local or sensitive data must stay excluded even inside an allowed directory.
**/__pycache__/
**/.venv/
**/venv/
**/node_modules/
**/.env
**/.env.*
**/credentials*
**/secrets*
**/auth.json
**/session*
**/cookies*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/id_rsa*
**/id_ed25519*
**/*.log
**/*.command.json
**/*.export.json
**/*.lock
**/*.pyc
**/*.bak
**/*~
**/backup/
**/backups/
**/.DS_Store
**/Thumbs.db
